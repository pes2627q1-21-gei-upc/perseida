POSTGRES_DB=perseida
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_DEFAULT_TTL_SECONDS=3600
APP_ENV=local
# Comma-separated: one OAuth client per platform (web, Android, iOS).
GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Fake value: put DEMO_KEY or your own key from https://api.nasa.gov in .env
NASA_API_KEY=your-nasa-api-key
# Optional (https only); these are the defaults. The feed is tried first, the
# JSON API is the fallback.
# NASA_APOD_FEED_URL=https://science.nasa.gov/feed/apod-basic/
# NASA_APOD_API_URL=https://api.nasa.gov/planetary/apod
# WebSocket /api/ws (TG-63): seconds to send the auth frame, and between heartbeat pings.
# These are the defaults.
# WS_AUTH_TIMEOUT_SECONDS=10
# WS_HEARTBEAT_SECONDS=30
# WS_MAX_ROOMS=20
# WS_MAX_FRAME_BYTES=65536
