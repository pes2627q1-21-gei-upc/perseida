# =============================================================================
# Perseida Infra – Plantilla de configuracio per a Docker Compose
# =============================================================================
# Copia aquest fitxer a .env dins d'infra/: cp .env.example .env
# El fitxer .env esta ignorat per git. MAI facis commit de claus reals.
# =============================================================================

# --- PostgreSQL (+ PostGIS) ---
POSTGRES_DB=perseida
POSTGRES_USER=perseida
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (Cache & Pub/Sub) ---
REDIS_HOST=cache
REDIS_PORT=6379
CACHE_DEFAULT_TTL_SECONDS=3600

# --- Scheduler (APScheduler integrat al proces de l'API) ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# --- Entorn i Seguretat de l'API ---
APP_ENV=production
API_IMAGE_TAG=latest
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars
GOOGLE_CLIENT_ID=change_me_google_client_id.apps.googleusercontent.com

# --- Ports del Host ---
HTTP_PORT=80
HTTPS_PORT=443
NPM_ADMIN_PORT=81
PORT=8000
