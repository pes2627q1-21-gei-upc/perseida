# Còpies de skills: es comparen byte a byte (sync-skills.mjs --check); fixem LF.
.agents/** text eol=lf
.claude/skills/** text eol=lf

# Scripts de shell: han de tenir LF perquè s'executin dins de contenidors Linux.
*.sh text eol=lf

# Efemèrides de Skyfield (TG-50): binari, mai es converteixen els salts de línia.
*.bsp binary
