# Frontend environment template. Copy to `.env` (git-ignored) and adjust it.
# EXPO_PUBLIC_* variables are bundled into the app: NEVER put secrets here.

# Backend origin, without the /api prefix (the generated paths already carry it).
# - Android emulator: http://10.0.2.2:8000
# - Physical phone with Expo Go: http://<your computer's LAN IP>:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth Client IDs (public client identifiers, safe to bundle in the app)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
# Deep link scheme for the Google OAuth callback ('app.perseida' by default: the package/bundle id registered in Google Cloud)
EXPO_PUBLIC_GOOGLE_REDIRECT_SCHEME=app.perseida
