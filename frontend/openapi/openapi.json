{
  "openapi": "3.1.0",
  "info": {
    "title": "Perseida API",
    "description": "Backend oficial del projecte Perseida - Arquitectura Hexagonal i API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Comprovació de salut del sistema",
        "description": "Retorna l'estat de salut de l'API i de tots els seus components subjacents (base de dades, cau, etc.) per a tasques de monitoratge i healthcheck.",
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "description": "L'estat de salut actual i el desglossament per components.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "components": {
                    "app": "ok"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/apod": {
      "get": {
        "tags": [
          "apod"
        ],
        "summary": "Imatge astronòmica del dia (APOD)",
        "description": "Retorna l'APOD de la data indicada o, si no se'n dona cap, el d'avui (data UTC). La data ha d'estar entre el 16/06/1995 i avui.",
        "operationId": "get_apod",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Data de l'APOD (YYYY-MM-DD). Per defecte, avui.",
              "examples": [
                "2026-10-14"
              ],
              "title": "Date"
            },
            "description": "Data de l'APOD (YYYY-MM-DD). Per defecte, avui."
          }
        ],
        "responses": {
          "200": {
            "description": "L'APOD de la data demanada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApodResponse"
                }
              }
            }
          },
          "422": {
            "description": "Data amb format incorrecte, futura o anterior al 16/06/1995.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperat.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "La NASA no respon i no hi ha dada a la cache (code `APOD_UNAVAILABLE`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Inici de sessió amb Google",
        "description": "Valida l'`id_token` de Google i retorna una sessió pròpia del backend (access i refresh token). El backend no desa cap contrasenya.",
        "operationId": "login_with_google",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "La sessió: access token, refresh token i durada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "El cos de la petició no es pot llegir (codificació no vàlida).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "El token de Google no és vàlid (code `INVALID_GOOGLE_TOKEN`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "El compte és suspès (`ACCOUNT_SUSPENDED`) o esborrat (`ACCOUNT_DELETED`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "El correu ja pertany a un altre compte (`EMAIL_ALREADY_REGISTERED`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Cos de la petició incorrecte.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Google no respon (`IDENTITY_PROVIDER_UNAVAILABLE`) o no es pot desar la sessió (`SESSION_UNAVAILABLE`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Renovació de la sessió",
        "description": "Canvia un refresh token vigent per un parell nou. El refresh anterior queda revocat: reutilitzar-lo és un error.",
        "operationId": "refresh_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "El parell nou de tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "El cos de la petició no es pot llegir (codificació no vàlida).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token invàlid, caducat o ja utilitzat (code `INVALID_SESSION`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Cos de la petició incorrecte.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "No es pot comprovar la sessió (`SESSION_UNAVAILABLE`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Tancament de sessió",
        "description": "Revoca la sessió sencera (access i refresh token) a la qual pertany el token `Bearer`. És idempotent: amb un token caducat, ja revocat, invàlid o sense token també respon 204.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Sessió tancada."
          },
          "503": {
            "description": "No es pot revocar la sessió (`SESSION_UNAVAILABLE`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {}
        ]
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Perfil de l'usuari autenticat",
        "description": "Retorna les dades de l'usuari propietari de la sessió.",
        "operationId": "get_current_user",
        "responses": {
          "200": {
            "description": "El perfil de l'usuari.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sessió absent, invàlida o revocada (`INVALID_SESSION`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "El compte és suspès (`ACCOUNT_SUSPENDED`) o esborrat (`ACCOUNT_DELETED`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "No es pot comprovar la sessió (`SESSION_UNAVAILABLE`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/events/active": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Esdeveniments actius en una data",
        "description": "Retorna els esdeveniments que estan en curs en algun moment del dia indicat (dia UTC, de 00:00Z a 24:00Z) o, si no se'n dona cap, d'avui. Un esdeveniment instantani compta com a actiu el dia en què passa, i un que acaba just a les 00:00Z també compta aquell dia. Endpoint públic, sense autenticació. Resposta: array ordenat per `starts_at` i després per `id`; buit si no n'hi ha cap.\n\nExemple de la forma de cada element (dades fictícies, no la resposta a uns paràmetres concrets):\n\n```json\n[\n  {\n    \"id\": \"01a19288-a3f6-7576-a37b-8926ca81b8fe\",\n    \"title\": \"Falcon 9 Block 5 | Starlink Group 10-12\",\n    \"summary\": \"A batch of Starlink satellites launched from Cape Canaveral SLC-40.\",\n    \"category\": \"launch\",\n    \"starts_at\": \"2026-11-03T21:15:00Z\",\n    \"ends_at\": \"2026-11-03T23:45:00Z\",\n    \"location\": {\n      \"latitude\": 28.5618,\n      \"longitude\": -80.577\n    },\n    \"source_url\": \"https://ll.thespacedevs.com/2.3.0/launches/00000000-0000-4000-8000-000000000000/\"\n  },\n  {\n    \"id\": \"01a19288-a3f6-7576-a37b-89276502d574\",\n    \"title\": \"Full Moon\",\n    \"summary\": \"The Moon is fully illuminated as seen from Earth.\",\n    \"category\": \"lunar\",\n    \"starts_at\": \"2026-11-24T14:53:00Z\",\n    \"ends_at\": \"2026-11-24T14:53:00Z\",\n    \"location\": null,\n    \"source_url\": null\n  }\n]\n```",
        "operationId": "get_active_events",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dia UTC (YYYY-MM-DD). Per defecte, avui.",
              "title": "Date"
            },
            "description": "Dia UTC (YYYY-MM-DD). Per defecte, avui.",
            "examples": {
              "full_moon": {
                "value": "2026-11-24"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Els esdeveniments actius aquell dia.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventResponse"
                  },
                  "title": "Response Get Active Events"
                }
              }
            }
          },
          "422": {
            "description": "Paràmetre invàlid (code `VALIDATION_ERROR`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperat (code `INTERNAL_ERROR`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/upcoming": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Esdeveniments que comencen els N dies vinents",
        "description": "Retorna els esdeveniments que comencen des d'ara fins d'aquí a `days` dies; els que ja han començat no hi surten (vegeu `/api/events/active`). Endpoint públic, sense autenticació. Resposta: array ordenat per `starts_at` i després per `id`; buit si no n'hi ha cap.\n\nExemple de la forma de cada element (dades fictícies, no la resposta a uns paràmetres concrets):\n\n```json\n[\n  {\n    \"id\": \"01a19288-a3f6-7576-a37b-8926ca81b8fe\",\n    \"title\": \"Falcon 9 Block 5 | Starlink Group 10-12\",\n    \"summary\": \"A batch of Starlink satellites launched from Cape Canaveral SLC-40.\",\n    \"category\": \"launch\",\n    \"starts_at\": \"2026-11-03T21:15:00Z\",\n    \"ends_at\": \"2026-11-03T23:45:00Z\",\n    \"location\": {\n      \"latitude\": 28.5618,\n      \"longitude\": -80.577\n    },\n    \"source_url\": \"https://ll.thespacedevs.com/2.3.0/launches/00000000-0000-4000-8000-000000000000/\"\n  },\n  {\n    \"id\": \"01a19288-a3f6-7576-a37b-89276502d574\",\n    \"title\": \"Full Moon\",\n    \"summary\": \"The Moon is fully illuminated as seen from Earth.\",\n    \"category\": \"lunar\",\n    \"starts_at\": \"2026-11-24T14:53:00Z\",\n    \"ends_at\": \"2026-11-24T14:53:00Z\",\n    \"location\": null,\n    \"source_url\": null\n  }\n]\n```",
        "operationId": "get_upcoming_events",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30,
              "minimum": 1,
              "description": "Nombre de dies vinents (1-30).",
              "default": 7,
              "title": "Days"
            },
            "description": "Nombre de dies vinents (1-30).",
            "examples": {
              "week": {
                "value": 7
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Els esdeveniments que comencen dins la finestra.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventResponse"
                  },
                  "title": "Response Get Upcoming Events"
                }
              }
            }
          },
          "422": {
            "description": "Paràmetre invàlid (code `VALIDATION_ERROR`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperat (code `INTERNAL_ERROR`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/quiz/today": {
      "get": {
        "tags": [
          "quiz"
        ],
        "summary": "Pregunta del quiz diari",
        "description": "Retorna la pregunta del dia (UTC) en l'idioma demanat, sense la solució. Si l'usuari ja ha respost, inclou el seu resultat.",
        "operationId": "get_quiz_today",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Language"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Idioma dels textos (ca, es o en). Per defecte, l'idioma preferit de l'usuari.",
              "title": "Lang"
            },
            "description": "Idioma dels textos (ca, es o en). Per defecte, l'idioma preferit de l'usuari."
          }
        ],
        "responses": {
          "200": {
            "description": "La pregunta del dia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizTodayResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sessió absent, invàlida o revocada (`INVALID_SESSION`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "El compte és suspès (`ACCOUNT_SUSPENDED`) o esborrat (`ACCOUNT_DELETED`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "`lang` no suportat o dades mal formades (`VALIDATION_ERROR`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "No es pot comprovar la sessió (`SESSION_UNAVAILABLE`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/quiz/today/answer": {
      "post": {
        "tags": [
          "quiz"
        ],
        "summary": "Respon la pregunta del quiz diari",
        "description": "Desa la resposta de l'usuari a la pregunta d'avui (UTC) i retorna si és correcta, amb l'explicació i la font. Només s'hi pot respondre un cop.",
        "operationId": "answer_quiz_today",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Language"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Idioma dels textos (ca, es o en). Per defecte, l'idioma preferit de l'usuari.",
              "title": "Lang"
            },
            "description": "Idioma dels textos (ca, es o en). Per defecte, l'idioma preferit de l'usuari."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "El resultat de la resposta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizResultResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sessió absent, invàlida o revocada (`INVALID_SESSION`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "El compte és suspès (`ACCOUNT_SUSPENDED`) o esborrat (`ACCOUNT_DELETED`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "La pregunta no és la del dia (`QUIZ_QUESTION_MISMATCH`), `lang` no suportat o dades mal formades (`VALIDATION_ERROR`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "No es pot comprovar la sessió (`SESSION_UNAVAILABLE`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "El cos de la petició no es pot llegir (codificació no vàlida).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Ja s'ha respost avui (`QUIZ_ALREADY_ANSWERED`) o la data no és la d'avui (`QUIZ_EXPIRED`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApodResponse": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date",
            "description": "Data de l'APOD",
            "examples": [
              "2026-10-14"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Títol de la imatge o vídeo"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Explicació de la NASA"
          },
          "media_type": {
            "$ref": "#/components/schemas/MediaType",
            "description": "Tipus de contingut (image, video)"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "URL del contingut multimèdia"
          },
          "copyright": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Copyright",
            "description": "Autoria, si l'APOD no és de domini públic"
          }
        },
        "type": "object",
        "required": [
          "date",
          "title",
          "explanation",
          "media_type",
          "url"
        ],
        "title": "ApodResponse"
      },
      "EventCategory": {
        "type": "string",
        "enum": [
          "lunar",
          "solar",
          "meteor_shower",
          "launch"
        ],
        "title": "EventCategory",
        "description": "Kinds of astronomical event, fixed by TG-50 (task #387)."
      },
      "EventLocation": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "examples": [
              28.5618
            ]
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "examples": [
              -80.577
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "EventLocation"
      },
