{
  "openapi": "3.1.0",
  "info": {
    "title": "Perseida API - APOD (contracte provisional)",
    "version": "0.0.0-provisional",
    "description": "Contracte provisional de TG-47 per desenvolupar el frontend (TG-117, TG-48) abans que el backend publiqui l'endpoint. Alineat amb l'ACORD de TG-47 (camps date i url, paràmetre date i error 422). Substituir per l'OpenAPI real del backend (/api/openapi.json) quan TG-47 estigui fusionada."
  },
  "paths": {
    "/api/apod": {
      "get": {
        "operationId": "get_apod",
        "summary": "Imatge astronòmica del dia (APOD)",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Data de l'APOD (YYYY-MM-DD). Per defecte, avui.",
            "schema": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] }
          }
        ],
        "responses": {
          "200": {
            "description": "L'APOD de la data demanada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApodResponse" }
              }
            }
          },
          "422": {
            "description": "Data amb format incorrecte, futura o anterior al 16/06/1995.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "500": {
            "description": "Error inesperat.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "La NASA no respon i no hi ha dada a la cache.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApodResponse": {
        "type": "object",
        "required": ["date", "title", "explanation", "media_type", "url"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "title": { "type": "string" },
          "explanation": { "type": "string" },
          "media_type": { "type": "string", "enum": ["image", "video"] },
          "url": { "type": "string" },
          "copyright": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message", "type"],
        "properties": {
          "field": { "type": "string" },
          "message": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "instance", "code", "correlation_id"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string" },
          "correlation_id": { "type": "string" },
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/FieldError" } }
        }
      }
    }
  }
}
