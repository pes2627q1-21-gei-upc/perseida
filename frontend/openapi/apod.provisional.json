{
  "openapi": "3.1.0",
  "info": {
    "title": "Perseida API - APOD (contracte provisional)",
    "version": "0.0.0-provisional",
    "description": "Contracte provisional de TG-47 per desenvolupar TG-117 abans que el backend publiqui l'endpoint. Substituir per l'OpenAPI real del backend (/api/openapi.json) quan TG-47 estigui fusionada."
  },
  "paths": {
    "/api/apod": {
      "get": {
        "operationId": "get_apod_today",
        "summary": "Imatge astronòmica del dia (APOD)",
        "responses": {
          "200": {
            "description": "L'APOD d'avui.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApodResponse" }
              }
            }
          },
          "500": {
            "description": "Error inesperat.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "La NASA no respon i no hi ha dada a la cache.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApodResponse": {
        "type": "object",
        "required": ["apod_date", "title", "explanation", "media_type", "media_url"],
        "properties": {
          "apod_date": { "type": "string", "format": "date" },
          "title": { "type": "string" },
          "explanation": { "type": "string" },
          "media_type": { "type": "string", "enum": ["image", "video"] },
          "media_url": { "type": "string" },
          "copyright": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message", "type"],
        "properties": {
          "field": { "type": "string" },
          "message": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "instance", "code", "correlation_id"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string" },
          "correlation_id": { "type": "string" },
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/FieldError" } }
        }
      }
    }
  }
}
