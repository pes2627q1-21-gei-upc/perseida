# Perseida environment template.
#
# Copy to `.env` and fill in the local values:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets in this file.
#
# This is the MINIMAL set needed to start the system. It must be extended by
# later user stories as new environment variables are added to the project
# (backend, frontend, infra, integrations...). Keep this file in sync: every
# new variable goes here, with a safe default or an empty value.

# --- PostgreSQL (+ PostGIS) ---
POSTGRES_DB=perseida
POSTGRES_USER=perseida
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend ---
APP_ENV=local
JWT_SECRET=

# --- Taiga unblock automation (.github/workflows/taiga-unblock.yml) ---
# Only used by GitHub Actions: TAIGA_USERNAME and TAIGA_PASSWORD are repository
# secrets, TAIGA_PROJECT_SLUG is a repository variable. Not needed to run locally.
TAIGA_USERNAME=
TAIGA_PASSWORD=
TAIGA_PROJECT_SLUG=
TAIGA_URL=https://api.taiga.io
DRY_RUN=0
